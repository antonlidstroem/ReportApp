<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<!-- IronSuiteProvider.cs is a stub kept for documentation only -->
	<ItemGroup>
		<Compile Remove="Providers\IronSuiteProvider.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ClosedXML" Version="0.102.2" />
		<PackageReference Include="DocumentFormat.OpenXml" Version="2.20.0" />

		<PackageReference Include="jsreport.AspNetCore" Version="3.8.1" />
		<PackageReference Include="jsreport.Binary" Version="4.4.0" />
		<PackageReference Include="jsreport.Local" Version="3.8.2" />

		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>

		<PackageReference Include="Syncfusion.Pdf.Net.Core" Version="24.1.41" />
		<PackageReference Include="Syncfusion.XlsIO.Net.Core" Version="24.1.41" />
		<PackageReference Include="Syncfusion.Presentation.Net.Core" Version="24.1.41" />
		<PackageReference Include="Syncfusion.Licensing" Version="24.1.41" />

		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
		<PackageReference Include="Microsoft.Playwright" Version="1.44.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ReportApp.AnalysisEngine\ReportApp.AnalysisEngine.csproj" />
		<ProjectReference Include="..\ReportApp.Core\ReportApp.Core.csproj" />
	</ItemGroup>

	<!--
    After building, install the Playwright Chromium browser if not already present.
    On Windows this runs the PowerShell script. On Linux/macOS it uses the shell script.
    Remove this target if you manage browser installs via CI/CD separately.
  -->
	<Target Name="InstallPlaywrightBrowser" AfterTargets="Build">
		<Exec Condition="$([MSBuild]::IsOSPlatform('Windows'))"
			  Command="powershell -ExecutionPolicy Bypass -File &quot;$(OutDir)playwright.ps1&quot; install chromium"
			  ContinueOnError="true" />
		<Exec Condition="!$([MSBuild]::IsOSPlatform('Windows'))"
			  Command="bash &quot;$(OutDir)playwright.sh&quot; install chromium"
			  ContinueOnError="true" />
	</Target>
</Project>